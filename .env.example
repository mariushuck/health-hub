# Kopieren nach .env.<person>, dann: chmod 600 .env.<person>
# Nur feste Secrets. Was sich zur Laufzeit ändert, liegt in data/<person>/.
GARMIN_PERSONAL_API_KEY=
# Ablaufdatum des Keys aus Garmin Connect als YYYY-MM-DD, die API nennt es nicht.
GARMIN_KEY_EXPIRES=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Ab Phase 2 und 3:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
